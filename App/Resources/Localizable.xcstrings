      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top and bottom margins are applied as reader chrome insets. Center alignment may fall back to leading in the EPUB engine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下边距以阅读器外框内边距方式应用。EPUB 引擎中居中对齐可能回退为左对齐。"
