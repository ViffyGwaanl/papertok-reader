    "sync.conflict_description.local_wins": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always prefer the local copy when conflicts occur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生冲突时始终优先本地副本。"
          }
