    "migration.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing your library, notes, and reading history from the previous version's database. This only covers data we can read from the legacy database."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在从旧版本的数据库导入书库、笔记与阅读记录。本迁移仅覆盖我们能从旧数据库读取的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在從舊版本的資料庫匯入書庫、筆記與閱讀記錄。本遷移僅涵蓋我們能從舊資料庫讀取的資料。"
          }
        }
      }
    },
