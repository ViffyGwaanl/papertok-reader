    "settings.ai_provider.failover_policy_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After N consecutive failures the key is marked failed; cooldowns control how long until it is retried."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续失败 N 次后，该密钥会被标记为失败；冷却时间决定何时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續失敗 N 次後，該金鑰會標記為失敗；冷卻時間決定何時重試。"
          }
        }
      }
