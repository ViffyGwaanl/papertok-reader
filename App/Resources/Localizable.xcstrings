    "ai.chat.system_prompt_default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are PaperTok Reader's AI reading assistant. Help users understand, summarize, translate, and organize their reading with clear, accurate, context-aware responses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是 PaperTok Reader 的 AI 阅读助手。请帮助用户理解、总结、翻译并整理阅读内容，回答要清晰、准确，并尽量基于当前上下文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是 PaperTok Reader 的 AI 閱讀助手。請幫助使用者理解、總結、翻譯並整理閱讀內容，回答要清晰、準確，並盡量基於目前情境。"
          }
        }
      }
    },
    "ai.chat.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل أي شيء عن قراءتك…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie etwas zu Ihrem Lesestoff…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask anything about your reading..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta cualquier cosa sobre tu lectura…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question sur votre lecture…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पठन के बारे में कुछ भी पूछें…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書について何でも聞いてください…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독서에 관해 무엇이든 물어보세요…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte qualquer coisa sobre sua leitura…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте вопрос о прочитанном…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามอะไรก็ได้เกี่ยวกับการอ่าน…"
          }
