          "stringUnit": {
            "state": "translated",
            "value": "请分析《%@》中的这张图片，说明它展示了什么、与当前阅读内容有什么关系，并使用用户偏好的语言作答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
