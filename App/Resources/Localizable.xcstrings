    "notes.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight text while reading to create notes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读时高亮文本即可创建笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀時標記文字即可建立筆記。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書中にテキストをハイライトしてノートを作成"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독서 중 텍스트를 하이라이트하여 노트를 만드세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surlignez du texte pendant la lecture pour créer des notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie Text beim Lesen, um Notizen zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resalta texto mientras lees para crear notas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaque texto durante a leitura para criar notas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделяйте текст при чтении, чтобы создавать заметки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتمييز النص أثناء القراءة لإنشاء ملاحظات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट बनाने के लिए पढ़ते समय टेक्स्ट हाइलाइट करें।"
          }
        },
        "th": {
